<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- System splash (core-splashscreen, all API levels): cream with the
             "spritz" wordmark instead of the launcher icon, matching iOS
             LaunchScreen.storyboard so the web launch layer takes over in the
             same pixels. launch_wordmark_icon is a vector (sharp at every
             density): a 288dp canvas with the 72dp wordmark centered; its
             widest point sits 94.7dp from the center, inside the 96dp radius
             Android 12+ masks to.
             No windowSplashScreenIconBackgroundColor on purpose: a background
             would shrink the icon area to 240dp and draw a circle behind it. -->
        <item name="windowSplashScreenBackground">#F4EFE6</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_wordmark_icon</item>
        <item name="android:background">@drawable/launch_splash</item>
    </style>
</resources>