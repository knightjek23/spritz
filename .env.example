# =====================================================================
# Spritz — environment variables
# Copy to .env.local and fill in. NEVER commit real values to this file
# or to .env.local.
# =====================================================================

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase ----------
# Get from: https://supabase.com/dashboard/project/_/settings/api-keys
# Use the NEW key types (legacy anon/service_role JWTs are deprecated and
# can't be rotated):
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  → sb_publishable_...  (safe for browsers)
#   SUPABASE_SERVICE_ROLE_KEY      → sb_secret_...       (server only, bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Clerk ----------
# Get from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=                  # for /api/webhooks/clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------- Stripe ----------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                 # for /api/webhooks/stripe
STRIPE_PRICE_ID_PRO_MONTHLY=           # price_xxx for $4.99/mo (Pro Monthly, 7-day trial applied in code)
STRIPE_PRICE_ID_PRO_ANNUAL=            # price_xxx for $29.99/yr (Pro Annual, billed upfront, no trial)
STRIPE_PRICE_ID_PRO_LIFETIME=          # price_xxx for $89 one-time (Pro Lifetime, non-recurring / "payment" mode)

# ---------- RevenueCat (mobile in-app purchases — App Store / Play) ----------
# Web uses Stripe (above); the iOS/Android shells use StoreKit / Play Billing
# via RevenueCat, which posts to /api/webhooks/revenuecat to grant Pro.
REVENUECAT_WEBHOOK_AUTH=                # exact value you set as the webhook Authorization header in RevenueCat
NEXT_PUBLIC_REVENUECAT_IOS_KEY=         # RevenueCat public SDK key (Apple) — used by the native client
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=    # RevenueCat public SDK key (Google) — for the later Android build

# ---------- Vision (PRD §7 — scan v2, see SCAN_V2_DESIGN.md) ----------
OPENAI_API_KEY=                        # label OCR + the same-house tiebreaker
GOOGLE_VISION_API_KEY=                 # Google Vision (cost fallback, not wired)
# OCR model is EVAL-GATED: run `npm run eval:scan` on ~30 of your own photos,
# then flip to the fastest model within 2 points of gpt-4o's accuracy.
# SCAN_OCR_MODEL=gpt-4.1-mini          # candidates: gpt-4.1-mini, gpt-5.4-mini, gpt-5-nano
# SCAN_OCR_DETAIL=auto                 # auto resolves to high at 1024 px (~765 tokens)
# SCAN_OCR_REASONING=none              # gpt-5.x only: none (5.4+) | minimal | low
# SCAN_OCR_TIMEOUT_MS=9000
# SCAN_TIEBREAK_TIMEOUT_MS=6000

# Visual layer — bottle shape/color embeddings (migration 0023 + `pnpm embed:images`)
VOYAGE_API_KEY=                        # voyage-multimodal-3.5; unset = visual layer off. `al-…` (Atlas) or `pa-…` (Voyage dashboard)
# VOYAGE_BASE_URL=                     # auto: al- keys → https://ai.mongodb.com/v1, others → https://api.voyageai.com/v1
# SCAN_VISUAL_PROVIDER=voyage          # or "off" to disable without removing the key
# SCAN_EMBED_MODEL=voyage-multimodal-3.5
# Fusion thresholds. Defaults were set from the catalog's own similarity
# distribution on 2026-08-26 (wrong-bottle cosine p50 0.82 / p90 0.94) and
# lean safe: visual breaks near-ties but can't override a clear label read,
# and a label-unreadable scan shows the picker rather than auto-matching.
# Re-fit from scan_events.candidates after ~2 weeks of real scans, or from
# `npm run eval:scan` with your own photos.
# SCAN_TEXT_AUTOMATCH=0.85
# SCAN_TEXT_FLOOR=0.40
# SCAN_FUSED_AUTOMATCH=0.75
# SCAN_FUSE_TEXT_WEIGHT=0.75
# SCAN_VISUAL_AUTOMATCH=0.97           # raw cosine, label-unreadable path
# SCAN_VISUAL_MARGIN=0.03
# SCAN_VISUAL_FLOOR=0.82               # cosine → 0..1 stretch used in fusion
# SCAN_VISUAL_CEIL=0.96
# SCAN_TIEBREAK_GAP=0.05

# Web fallback (Phase 3) — Google Lens via SerpApi. OFF by default; sends the
# user's photo to a third party (privacy policy names it). Signed-in only.
# Needs a PRIVATE Storage bucket named "scan-images".
# SCAN_WEB_FALLBACK=true
# SERPAPI_API_KEY=
# SCAN_WEB_DAILY_BUDGET=100
# SCAN_WEB_KEEP_IMAGE=false

# ---------- Affiliate links ----------
SCENTBIRD_AFFILIATE_ID=
FRAGRANCENET_AFFILIATE_ID=
NORDSTROM_AFFILIATE_ID=

# ---------- Analytics (Q9, default PostHog) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------- Rate limits (PRD §7) ----------
SCAN_RATE_LIMIT_ANON=10                # per day per IP
SCAN_RATE_LIMIT_FREE=50                # per day per signed-in free user
SCAN_RATE_LIMIT_PRO=300                # per day per Pro user (generous anti-abuse ceiling; GPT-4o vision is the pricey call)
SCAN_GLOBAL_DAILY_BUDGET=2000          # hard daily cap across ALL scans (model spend ceiling)

# AI generation ceiling — paid dupes + consensus (model called only on cache miss)
AI_GEN_RATE_LIMIT=20                   # generations per user per window (burst guard)
AI_GEN_RATE_WINDOW_MIN=10              # window length in minutes for AI_GEN_RATE_LIMIT
# Hard backstop for total AI spend: set a spend limit in your model provider's
# dashboard (OpenAI today; Anthropic if you migrate the AI features to Claude).
