# dependencies — any node_modules anywhere (root, scraper, editorial,
# trends-collector, etc.). If a nested one is already tracked, untrack it:
#   git rm -r --cached <path>/node_modules
**/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# npm is the package manager of record — block other lockfiles from
# reappearing (root had both package-lock.json and pnpm-lock.yaml, which
# makes Vercel's package-manager detection nondeterministic)
pnpm-lock.yaml
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit
.env
.env*.local
.env.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# scraper output (raw HTML + parsed JSON, gitignored — rebuild from source)
/scraper/data/raw/
/scraper/data/parsed/
/scraper/data/*.log

# supabase
supabase/.branches
supabase/.temp

# IDE
.vscode/
.idea/

# screenshots: regenerated locally, never committed
/screenshots/
/.auth/
scripts/*.log
node_modules.old/
node_modules.partial/

# Affiliate product feeds — licensed third-party data, do not commit.
# The affiliate licence covers using these to promote that advertiser; it does
# not cover redistributing the feed, which is what pushing it to a repo does.
# All of it is regenerable from the network dashboards.
#
# NOTE: the `**` matters. The old single-level patterns (scraper/data/*.txt)
# did NOT cover scraper/data/rakuten/216_4736579_mp.txt — 28 MB of licensed
# FragranceNet catalogue that was one `git add scraper/` away from being
# published.
scraper/data/productcatalog/
scraper/data/rakuten/
scraper/data/perfumania/
scraper/data/**/*.txt
scraper/data/**/*.csv
scraper/data/**/*.tsv
scraper/data/**/*.zip
scraper/data/**/*.gz
scraper/data/**/*.xml

# scan v2 eval set (your photos + labels, local only)
eval/
_to_delete/

# Local App Store capture assets — large binaries, not source
spritz movs/
