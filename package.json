{
  "name": "spritz",
  "version": "0.1.0",
  "private": true,
  "description": "Spritz — scan a bottle, know everything about it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:server-onclick": "node scripts/check-server-onclick.mjs",
    "prebuild": "npm run check:server-onclick",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "screenshots:auth": "node scripts/screenshots/auth.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "eval:scan": "tsx scripts/scan-eval.ts",
    "test:purge": "tsx scripts/test-account-purge.ts",
    "diag:infra": "tsx scripts/diag-storage-tables.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@clerk/nextjs": "^5.7.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/functions": "^3.9.5",
    "next": "14.2.35",
    "openai": "^4.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "stripe": "^17.1.0",
    "svix": "^1.36.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.60.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
